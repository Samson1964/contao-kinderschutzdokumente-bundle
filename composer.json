{
    "name": "schachbulle/contao-kinderschutzdokumente-bundle",
    "type": "contao-bundle",
    "description": "Mitglieder reichen Kinderschutz-Unterlagen wie das erweiterte Führungszeugnis online ein; Prüfer sehen im Backend, wer vollständig ist und was fehlt.",
    "keywords": [
        "contao",
        "kinderschutz",
        "führungszeugnis",
        "ehrenkodex",
        "mitglieder"
    ],
    "homepage": "https://github.com/Samson1964/contao-kinderschutzdokumente-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.7"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoKinderschutzdokumenteBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoKinderschutzdokumenteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoKinderschutzdokumenteBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-kinderschutzdokumente-bundle/issues",
        "source": "https://github.com/Samson1964/contao-kinderschutzdokumente-bundle"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    }
}
