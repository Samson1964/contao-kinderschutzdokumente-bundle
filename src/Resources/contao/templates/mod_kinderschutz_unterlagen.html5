<?php

use Contao\Date;
use Contao\Input;
use Contao\StringUtil;

$this->extend('block_unsearchable');
?>

<?php $this->block('content'); ?>
<?php $t = $this->texte; ?>

<?php if ('' !== $this->hinweis): ?>
  <p class="ks-hinweis"><?= $this->hinweis ?></p>
<?php elseif (isset($this->antrag)): ?>
  <?php $a = $this->antrag; ?>
  <?php // Texte des Mitglieds kommen roh aus der Anfrage: maskieren und Insert-Tags entschärfen, die Contao sonst in der Seite ersetzt ?>
  <?php $sicher = static fn ($text): string => Input::encodeInsertTags(StringUtil::specialchars((string) $text)); ?>

  <?php foreach ($this->meldungen as $meldung): ?>
    <p class="ks-meldung" role="status"><?= StringUtil::specialchars($meldung) ?></p>
  <?php endforeach; ?>

  <h2 class="ks-ueberschrift"><?= $t['antragUeberschrift'] ?></h2>
  <?php if (null !== $a['offen']): ?>
    <p class="ks-text"><?= sprintf($t['antragOffen'], Date::parse('d.m.Y', (int) $a['offen']['beantragtAm'])) ?></p>
    <p class="ks-text ks-grund"><?= nl2br($sicher($a['offen']['wofuer'])) ?></p>
    <?php if (!empty($a['gewaehlte'])): ?>
      <p class="ks-text"><?= $t['antragGewaehlt'] ?></p>
      <ul class="ks-antrag-gewaehlt">
        <?php foreach ($a['gewaehlte'] as $v): ?>
          <li><?= $sicher($v['name']) ?> (<?= Date::parse('d.m.Y', (int) $v['startDate']) ?>)</li>
        <?php endforeach; ?>
      </ul>
    <?php endif; ?>
  <?php else: ?>
    <p class="ks-text"><?= $t['antragErklaerung'] ?></p>
    <?php if (null !== $a['abgelehnt']): ?>
      <p class="ks-text ks-grund"><?= sprintf($t['antragAbgelehnt'], Date::parse('d.m.Y', (int) $a['abgelehnt']['beantragtAm']), nl2br($sicher($a['abgelehnt']['grund']))) ?></p>
    <?php endif; ?>
    <?php if ('' !== $a['fehler']): ?><p class="ks-fehler" role="alert" id="ks-antrag-fehler"><?= StringUtil::specialchars($a['fehler']) ?></p><?php endif; ?>
    <form method="post" class="ks-formular ks-antrag">
      <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formular ?>_antrag">
      <input type="hidden" name="REQUEST_TOKEN" value="<?= StringUtil::specialchars($this->requestToken) ?>">
      <label for="ks-wofuer"><?= $t['wofuer'] ?></label>
      <textarea name="wofuer" id="ks-wofuer" rows="4" maxlength="<?= (int) $a['maximal'] ?>" required<?= '' !== $a['fehler'] ? ' aria-describedby="ks-antrag-fehler"' : '' ?>><?= $sicher($a['wofuer']) ?></textarea>
      <?php if (!empty($a['waehlbare'])): ?>
        <fieldset class="ks-antrag-veranstaltungen">
          <legend><?= $t['antragVeranstaltungen'] ?></legend>
          <?php foreach ($a['waehlbare'] as $v): ?>
            <label><input type="checkbox" name="veranstaltungen[]" value="<?= (int) $v['id'] ?>"> <?= StringUtil::specialchars($v['name']) ?> (<?= Date::parse('d.m.Y', (int) $v['startDate']) ?>)</label>
          <?php endforeach; ?>
        </fieldset>
      <?php endif; ?>
      <button type="submit"><?= $t['antragStellen'] ?></button>
    </form>
  <?php endif; ?>

<?php else: ?>

  <?php foreach ($this->meldungen as $meldung): ?>
    <p class="ks-meldung" role="status"><?= StringUtil::specialchars($meldung) ?></p>
  <?php endforeach; ?>

  <h2 class="ks-ueberschrift"><?= $t['unterlagen'] ?></h2>
  <ul class="ks-liste">
    <?php foreach ($this->arten as $art): ?>
      <?php $zelle = $this->zellen[$art->id]; ?>
      <?php // Das Prüfergebnis soll auch im Quelltext nicht stehen ?>
      <li class="ks-art ks-<?= 'beanstandet' === $zelle->status ? 'ruecksprache' : $zelle->status ?>">
        <div class="ks-kopf">
          <strong><?= StringUtil::specialchars($art->name) ?></strong>
          <?php if ($art->pflicht): ?><span class="ks-pflicht"><?= $t['pflicht'] ?></span><?php endif; ?>
          <span class="ks-status"><?= $GLOBALS['TL_LANG']['MSC']['kinderschutz_status_frontend'][$zelle->status] ?></span>
        </div>
        <?php if ('' !== $art->hinweis): ?><p class="ks-text"><?= nl2br(StringUtil::specialchars($art->hinweis)) ?></p><?php endif; ?>
        <?php if (null !== $zelle->massgeblich && $zelle->istGueltig()): ?>
          <p class="ks-text"><?= null === $zelle->massgeblich->gueltigBis ? $t['unbegrenzt'] : sprintf($t['gueltigBis'], Date::parse('d.m.Y', $zelle->massgeblich->gueltigBis)) ?></p>
        <?php endif; ?>
        <?php if ('abgelehnt' === $zelle->status && null !== $zelle->letzter && '' !== $zelle->letzter->ablehnungsgrund): ?>
          <p class="ks-text ks-grund"><?= sprintf($t['grund'], nl2br(StringUtil::specialchars($zelle->letzter->ablehnungsgrund))) ?></p>
        <?php endif; ?>
        <?php if ($zelle->wartet() && 'eingereicht' !== $zelle->status): ?><p class="ks-text"><?= $t['wartet'] ?></p><?php endif; ?>
        <?php if (isset($this->fehler[$art->id])): ?><p class="ks-fehler" role="alert"><?= StringUtil::specialchars($this->fehler[$art->id]) ?></p><?php endif; ?>

        <form method="post" enctype="multipart/form-data" class="ks-formular">
          <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formular ?>_upload">
          <input type="hidden" name="REQUEST_TOKEN" value="<?= StringUtil::specialchars($this->requestToken) ?>">
          <input type="hidden" name="dokumentart" value="<?= $art->id ?>">
          <label for="ks-datei-<?= $art->id ?>"><?= sprintf($t['datei'], $this->hoechstgroesse) ?></label>
          <input type="file" name="datei" id="ks-datei-<?= $art->id ?>" accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" required>
          <label for="ks-datum-<?= $art->id ?>"><?= $t['ausgestellt'] ?></label>
          <input type="date" name="ausstellungsdatum" id="ks-datum-<?= $art->id ?>" max="<?= $this->heute ?>" required>
          <button type="submit"><?= $zelle->istGueltig() ? $t['erneuern'] : $t['hochladen'] ?></button>
        </form>
      </li>
    <?php endforeach; ?>
  </ul>

  <h2 class="ks-ueberschrift"><?= $t['veranstaltungen'] ?></h2>
  <?php if (isset($this->fehler[0])): ?><p class="ks-fehler" role="alert"><?= StringUtil::specialchars($this->fehler[0]) ?></p><?php endif; ?>
  <ul class="ks-liste">
    <?php foreach ($this->eigene as $eintrag): ?>
      <?php $v = $eintrag['veranstaltung']; ?>
      <li class="ks-veranstaltung <?= array() === $eintrag['fehlend'] ? 'ks-gueltig' : 'ks-fehlt' ?>">
        <div class="ks-kopf">
          <strong><?= StringUtil::specialchars($v['name']) ?></strong>
          <span><?= Date::parse('d.m.Y', (int) $v['startDate']) ?><?= (int) $v['endDate'] > 0 ? ' – '.Date::parse('d.m.Y', (int) $v['endDate']) : '' ?></span>
        </div>
        <p class="ks-text">
          <?= array() === $eintrag['fehlend'] ? $t['vollstaendig'] : sprintf($t['esFehlt'], StringUtil::specialchars(implode(', ', array_map(static fn ($art) => $art->name, $eintrag['fehlend'])))) ?>
        </p>
        <?php if ('frontend' === $v['quelle']): ?>
          <form method="post" class="ks-formular">
            <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formular ?>_veranstaltung">
            <input type="hidden" name="REQUEST_TOKEN" value="<?= StringUtil::specialchars($this->requestToken) ?>">
            <input type="hidden" name="veranstaltung" value="<?= (int) $v['id'] ?>">
            <input type="hidden" name="aktion" value="abmelden">
            <button type="submit"><?= $t['abmelden'] ?></button>
          </form>
        <?php else: ?>
          <p class="ks-text ks-gesperrt">🔒 <?= $t['gesperrt'] ?></p>
        <?php endif; ?>
      </li>
    <?php endforeach; ?>
  </ul>

  <h3 class="ks-ueberschrift"><?= $t['waehlbar'] ?></h3>
  <?php if (empty($this->waehlbare)): ?>
    <p class="ks-text"><?= $t['keineWaehlbar'] ?></p>
  <?php else: ?>
    <ul class="ks-liste">
      <?php foreach ($this->waehlbare as $v): ?>
        <li class="ks-veranstaltung">
          <form method="post" class="ks-formular ks-zeile">
            <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formular ?>_veranstaltung">
            <input type="hidden" name="REQUEST_TOKEN" value="<?= StringUtil::specialchars($this->requestToken) ?>">
            <input type="hidden" name="veranstaltung" value="<?= (int) $v['id'] ?>">
            <input type="hidden" name="aktion" value="anmelden">
            <span><strong><?= StringUtil::specialchars($v['name']) ?></strong> (<?= Date::parse('d.m.Y', (int) $v['startDate']) ?>)</span>
            <button type="submit"><?= $t['anmelden'] ?></button>
          </form>
        </li>
      <?php endforeach; ?>
    </ul>
  <?php endif; ?>

<?php endif; ?>
<?php $this->endblock(); ?>
